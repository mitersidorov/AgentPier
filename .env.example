# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=AgentPier
PORT=3000
MANAGER_PORT=3100
FRONTEND_PORT=3101
NODE_ENV=development
# ─────────────────────────────────────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=agentpier
DB_PASSWORD=replace-with-a-local-password
DB_NAME=agentpier

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible database backups
# Leave S3_ENDPOINT empty for AWS S3. Set it for another remote S3-compatible provider.
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentpier-backups
S3_FORCE_PATH_STYLE=true
S3_PREFIX=agentpier/
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_COUNT=5
RESTORE_TEST_DB=agentpier_restore_test
CODEX_APP_SERVER_URL=ws://host.docker.internal:4500

# ─────────────────────────────────────────────────────────────────────────────
# HTTP client (for external service calls)
# ─────────────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
HTTP_RETRY_DELAY_MS=1000
