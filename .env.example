# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=AgentPier
PORT=3000
MANAGER_PORT=3100
NODE_ENV=development
# Comma-separated list of allowed origins (production only)
CORS_ORIGINS=https://app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Swagger (production only)
# ─────────────────────────────────────────────────────────────────────────────
SWAGGER_SERVER_URL=http://manager:3000

# ─────────────────────────────────────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=agentpier
DB_PASSWORD=replace-with-a-local-password
DB_NAME=agentpier

# ─────────────────────────────────────────────────────────────────────────────
# S3 / MinIO object storage
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentpier-backups
S3_FORCE_PATH_STYLE=true
S3_PREFIX=agentpier/
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
CODEX_APP_SERVER_URL=ws://host.docker.internal:4500

# ─────────────────────────────────────────────────────────────────────────────
# HTTP client (for external service calls)
# ─────────────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
HTTP_RETRY_DELAY_MS=1000
